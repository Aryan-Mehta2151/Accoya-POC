# ===== App =====
APP_ENV=development
API_PREFIX=/api

# ===== Database (Postgres / RDS) =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_marketing

# ===== AWS =====
# Use IAM user's PROGRAMMATIC keys (access key id + secret access key).
# Leave empty when running on AWS with an IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== S3 =====
S3_BUCKET_STRATEGY_DOCS=your-bucket-name

# ===== Bedrock Knowledge Base =====
BEDROCK_KB_ID=your-kb-id
# Can be either a model ID (recommended) or full ARN.
# Example model ID in us-east-2: anthropic.claude-sonnet-5
BEDROCK_KB_MODEL_ARN=anthropic.claude-sonnet-5
BEDROCK_KB_TOP_K=5

# ===== Gemini =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=180

# ===== Email generation worker =====
EMAIL_GENERATION_WORKER_POLL_SECONDS=2
EMAIL_GENERATION_HEARTBEAT_SECONDS=15
EMAIL_GENERATION_STALE_SECONDS=300

# ===== EarlyBid lead feed =====
LEAD_API_BASE_URL=https://api.earlybid.bid
LEAD_API_KEY=
LEAD_FEED_RESELLER=amped
LEAD_FEED_CLIENT=amped-accoya-materials
