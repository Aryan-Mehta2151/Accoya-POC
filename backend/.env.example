# ===== App =====
APP_ENV=development
# Set APP_ENV=production explicitly in production; never inherit this default.
API_PREFIX=/api
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Open the local frontend and API through the same hostname (both localhost or
# both 127.0.0.1) so SameSite=Lax cookies are sent.

# ===== Database (Postgres / RDS) =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_marketing

# ===== AWS =====
# Use IAM user's PROGRAMMATIC keys (access key id + secret access key).
# Leave empty when running on AWS with an IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== S3 =====
S3_BUCKET_STRATEGY_DOCS=your-bucket-name

# ===== Bedrock Knowledge Base =====
BEDROCK_KB_ID=your-kb-id
# Can be either a model ID (recommended) or full ARN.
# Example model ID in us-east-2: anthropic.claude-sonnet-5
BEDROCK_KB_MODEL_ARN=anthropic.claude-sonnet-5
BEDROCK_KB_TOP_K=5

# ===== Gemini =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=180

# ===== Email generation worker =====
EMAIL_GENERATION_WORKER_POLL_SECONDS=2
EMAIL_GENERATION_HEARTBEAT_SECONDS=15
EMAIL_GENERATION_STALE_SECONDS=300

# ===== Email delivery worker =====
EMAIL_DELIVERY_WORKER_POLL_SECONDS=2
EMAIL_DELIVERY_HEARTBEAT_SECONDS=15
EMAIL_DELIVERY_STALE_SECONDS=300

# ===== EarlyBid lead feed =====
LEAD_API_BASE_URL=https://api.earlybid.bid
LEAD_API_KEY=
LEAD_FEED_RESELLER=amped
LEAD_FEED_CLIENT=amped-accoya-materials

# ===== Daily EarlyBid synchronization worker =====
LEAD_AUTO_SYNC_TIMEZONE=America/Los_Angeles
LEAD_AUTO_SYNC_HEARTBEAT_SECONDS=15
LEAD_AUTO_SYNC_STALE_SECONDS=300
LEAD_AUTO_SYNC_POLL_SECONDS=30

# ===== Authentication =====
JWT_SECRET_KEY=
CSRF_SECRET_KEY=
JWT_ISSUER=accoya-api
JWT_AUDIENCE=accoya-web
AUTH_COOKIE_SECURE=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
ACCESS_REQUEST_TOKEN_EXPIRE_MINUTES=1440
ACCESS_REQUEST_COOLDOWN_MINUTES=15
# Replace this generic placeholder with the approved reviewer mailbox.
ACCESS_REQUEST_APPROVER_EMAIL=approver@example.com
FRONTEND_URL=http://localhost:5173

# ===== Google OAuth =====
# Both credentials and this exact callback path are required outside development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# ===== SMTP =====
# SMTP2GO submission uses STARTTLS. Keep all credentials blank in this tracked file.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
# SMTP_USERNAME is the relay login; SMTP_EMAIL is the verified From address.
SMTP_USERNAME=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=30
